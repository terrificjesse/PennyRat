# K2 Think V2, via the Institute of Foundation Models. Access is granted through
# build.k2think.ai — the base URL comes from that onboarding, not from public docs.
# The endpoint is OpenAI-compatible, so BASE_URL should end in /v1.
IFM_API_KEY=OOPSIE
IFM_BASE_URL=https://api.k2think.ai/v1
IFM_MODEL=MBZUAI-IFM/K2-Think-v2

# live    call K2 for real, write results to .k2cache/
# cache   serve from .k2cache/ only, fail on a miss
# fixture never touch the network, serve src/fixtures/ (the default, works keyless)
K2_MODE=fixture
